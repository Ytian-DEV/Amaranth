# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public site URL (canonical links, sharing)
VITE_SITE_URL=https://amaranth.example

# Server side (Vercel middleware + /api functions). Optional: they fall back to the VITE_ values.
# SITE_URL is used for canonical links, sitemap.xml and rss.xml.
SITE_URL=https://amaranth.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile (CAPTCHA on comments, submissions and contact). Site key is public;
# the secret key and the service role key are server-only (Vercel env, or .env.local for npm run dev).
# Leave these empty locally to use Cloudflare's always-pass test keys.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Needed by /api/submit (forms) and /api/e (statistics). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
