# Supabase project (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public site URL (canonical links, sharing)
VITE_SITE_URL=https://amaranth.example

# Server side (Vercel middleware + /api functions). Optional: they fall back to the VITE_ values.
# SITE_URL is used for canonical links, sitemap.xml and rss.xml.
SITE_URL=https://amaranth.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
